{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=usersstoredb;Trusted_Connection=True;"
  },

  // Данные из этой секции будут передаваться MailSetting, чтобы не определять напрямую(hard code) свои личные данные.
  // Конфиденциальные данные распологаются в appsettings.Development.json.
  // При редактировании appsettings.Development.json добавьте gitignore, чтобы не отправить свои личные данные в открытый доступ.

  "MailSettings": {
    "Mail": "<fromemail>",
    "DisplayName": "<displayname>",
    "Password": "<yourpasswordhere>",
    "Host": "smtp.gmail.com",
    "Port": 587
  }
}
